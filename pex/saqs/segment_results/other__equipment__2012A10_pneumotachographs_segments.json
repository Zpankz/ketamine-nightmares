        "equipment_and_physics"
      ],
      "key_facts": []
    },
    {
      "id": "seg:16",
      "start": 532,
      "end": 601,
      "level": 2,
      "text_preview": "·\nReynolds number: Re = (diameter x velocity x\n  density) / viscosity",
