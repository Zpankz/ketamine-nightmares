      ],
      "key_facts": []
    },
    {
      "id": "seg:15",
      "start": 450,
      "end": 531,
      "level": 2,
      "text_preview": "·\nPoiseuille equation: Resistance = (8 x length\n  x viscosity) / (\nπ\nx radius\n4\n)",
