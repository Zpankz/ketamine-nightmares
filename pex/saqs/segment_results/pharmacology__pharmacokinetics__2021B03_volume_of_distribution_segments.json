  "segments": [
    {
      "id": "seg:12",
      "start": 494,
      "end": 549,
      "level": 2,
      "text_preview": "·\nDrugs given or absorbed into plasma, then\ndistributed",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:20",
      "start": 813,
      "end": 887,
      "level": 2,
      "text_preview": "·\n>600mL/kg: fat (e.g. propofol) or tissue\nprotein-bound (e.g. amiodarone)",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:28",
      "start": 1164,
      "end": 1218,
      "level": 0,
      "text_preview": "·\nNeonate: ↑total body water,\n↑V\nD\nwater soluble drugs",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:29",
      "start": 1219,
      "end": 1273,
      "level": 0,
      "text_preview": "·\nPregnant: ↑muscle,\n↑adipose, ↑water;\n↑V\nD\nmost drugs",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:30",
      "start": 1274,
      "end": 1337,
      "level": 0,
      "text_preview": "·\nElderly: ↓muscle, ↓water,\n↑%adipose: ↓V\nD\nwater soluble\ndrugs",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:32",
      "start": 1348,
      "end": 1419,
      "level": 1,
      "text_preview": "·\nFluid overload (heart/liver/kidney failure):\n↑V\nD\nwater soluble drugs",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": [
        {
          "question": "What is the key fact or definition stated here?",
          "answer": "Fluid overload",
          "score": 0.08471477758389075
        }
      ]
    },
    {
      "id": "seg:33",
      "start": 1420,
      "end": 1499,
      "level": 1,
      "text_preview": "·\n↓Plasma proteins (e.g. liver failure):\n↑V\nD\nhighly plasma protein bound\ndrugs",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:34",
      "start": 1500,
      "end": 1575,
      "level": 1,
      "text_preview": "·\nIf low hepatic extraction ratio:\n↑↑Free drug ->\n↑↑effect (e.g. phenytoin)",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:35",
      "start": 1576,
      "end": 1651,
      "level": 1,
      "text_preview": "·\nDehydration: ↓V\nDC\nmost\ndrugs (e.g. propofol), ↓V\nDSS\nwater-soluble\ndrugs",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": [
        {
          "question": "What is the key fact or definition stated here?",
          "answer": "Dehydration",
          "score": 0.01701262138905028
        }
      ]
    },
    {
      "id": "seg:40",
      "start": 1753,
      "end": 1811,
      "level": 2,
      "text_preview": "·\nV\nD\n= n / C (where\n‘n’ is the total bioavailable\namount)",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:42",
      "start": 1822,
      "end": 1914,
      "level": 2,
      "text_preview": "·\nV\nD\n= amount of drug / measured\nconcentration\n(loading dose = V\nD\nx desired concentration)",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:48",
      "start": 2030,
      "end": 2082,
      "level": 2,
      "text_preview": "·\nNo metabolism or excretion prior to blood\nsampling",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    },
    {
      "id": "seg:51",
      "start": 2130,
      "end": 2193,
      "level": 2,
      "text_preview": "·\nPredict offset after drug infusion (e.g.\npropofol TCI models)",
      "inherited_dimensions": [
        "pharmacokinetic_process",
        "special_population_role"
      ],
      "key_facts": []
    }
  ]
}