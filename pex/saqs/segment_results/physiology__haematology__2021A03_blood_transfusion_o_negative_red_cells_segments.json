      "id": "seg:9",
      "start": 347,
      "end": 417,
      "level": 1,
      "text_preview": "·\nTransfusion safe only if recipient won’t produce\nAb against donor Ag",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:14",
      "start": 480,
      "end": 531,
      "level": 2,
      "text_preview": "·\nCommon oligosaccharide foundation = “O\n  antigen”",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:19",
      "start": 623,
      "end": 714,
      "level": 2,
      "text_preview": "·\nNon-self anti-A, Anti-B developed in first\n  year of life if type O blood (diet exposure)",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:24",
      "start": 807,
      "end": 862,
      "level": 2,
      "text_preview": "·\nIncompatibility -> intravascular haemolysis\n  (worse)",
      "inherited_dimensions": [],
      "key_facts": [
        {
          "question": "What is the key fact or definition stated here?",
          "answer": "Incompatibility",
          "score": 0.027223122060953172
        }
      ]
    },
    {
      "id": "seg:25",
      "start": 863,
      "end": 940,
      "level": 2,
      "text_preview": "·\nNote no plasma in donor packed RBCs, hence\n  donor’s antibodies unimportant",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:30",
      "start": 1025,
      "end": 1109,
      "level": 2,
      "text_preview": "·\nNon-self Anti-RhD only developed after\n  exposure to RhD+ blood (no diet exposure)",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:34",
      "start": 1159,
      "end": 1225,
      "level": 2,
      "text_preview": "·\nIncompatibility -> extravascular haemolysis\n  (not quite as bad)",
      "inherited_dimensions": [],
      "key_facts": [
        {
          "question": "What is the key fact or definition stated here?",
          "answer": "Incompatibility",
          "score": 0.018170895188456195
        }
      ]
    },
    {
      "id": "seg:36",
      "start": 1267,
      "end": 1500,
      "level": 2,
      "text_preview": "·\nImportant to avoid sensitization in females of\n  childbearing potential:\n·\nFirst time: Rh- mother,",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:37",
      "start": 1342,
      "end": 1398,
      "level": 3,
      "text_preview": "·\nFirst time: Rh- mother, Rh+ neonate ->\n  sensitization",
      "inherited_dimensions": [],
      "key_facts": [
        {
          "question": "What is the key fact or definition stated here?",
          "answer": "sensitization",
          "score": 0.023372116153952502
        }
      ]
    },
    {
      "id": "seg:38",
      "start": 1399,
      "end": 1500,
      "level": 3,
      "text_preview": "·\nSecond time: Rh+ neonate, maternal Anti-RhD\n  IgG causes hydrops foetalis, haemolytic Dx of newbor",
      "inherited_dimensions": [],
      "key_facts": []
    },
    {
      "id": "seg:42",
      "start": 1571,
      "end": 1649,
      "level": 2,
      "text_preview": "·\nPlasma has anti-A, anti-B, +/- anti-RhD but\n  these are washed from RBC unit",
