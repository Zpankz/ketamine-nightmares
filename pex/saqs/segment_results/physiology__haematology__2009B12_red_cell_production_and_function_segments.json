    {
      "id": "seg:44",
      "start": 1628,
      "end": 1951,
      "level": 2,
      "text_preview": "·\nHaldane effect: deoxyHb carries more\nCO\n2\nand H\n+\nthan oxyHb\no\n70% due to 3.5x↑ formation of\ncarba",
      "inherited_dimensions": [
        "gas_exchange_process",
        "acid_base_quality",
        "special_population_role"
