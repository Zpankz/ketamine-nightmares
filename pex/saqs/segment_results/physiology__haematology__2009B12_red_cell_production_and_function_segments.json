      "key_facts": []
    },
    {
      "id": "seg:47",
      "start": 1772,
      "end": 1880,
      "level": 3,
      "text_preview": "o\nHence isohydric buffering: for every 1mol O\n2\noffloaded, 0.7mol CO\n2\nand H\n+\ncan be added,\nbefore ",
