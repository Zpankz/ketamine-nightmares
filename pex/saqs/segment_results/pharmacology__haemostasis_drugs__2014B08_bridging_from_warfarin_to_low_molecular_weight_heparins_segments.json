        "pharmacology_mechanisms",
        "special_populations"
      ],
      "key_facts": []
    },
    {
      "id": "seg:17",
      "start": 777,
      "end": 845,
      "level": 1,
      "text_preview": "·\nCheck INR on AM of surgery; usually aim\n  <1.5 (surgery dependent)",
