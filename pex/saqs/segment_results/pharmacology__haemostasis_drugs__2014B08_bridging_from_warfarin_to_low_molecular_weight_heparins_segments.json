    {
      "id": "seg:10",
      "start": 417,
      "end": 485,
      "level": 2,
      "text_preview": "·\nLMWH: short duration, parenteral only, only\n  partially reversible",
      "inherited_dimensions": [
        "pharmacology_mechanisms",
        "special_populations"
      ],
      "key_facts": []
    },
    {
      "id": "seg:12",
      "start": 492,
      "end": 572,
      "level": 2,
      "text_preview": "·\nOf bleeding: Warfarin and LMWH have additive\n  effects -> avoid overlap pre-op",
      "inherited_dimensions": [
        "pharmacology_mechanisms",
        "special_populations"
      ],
      "key_facts": [
        {
          "question": "What is the key fact or definition stated here?",
